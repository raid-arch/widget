<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/panel" android:padding="16dp">
<TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/tasks" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="提出物" android:textColor="#7EE4D0"/>
<TextView android:id="@+id/lessons" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="授業" android:textColor="#7EE4D0"/>
<TextView android:id="@+id/events" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:text="予定" android:textColor="#7EE4D0"/>
<TextView android:id="@+id/add" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="＋" android:textSize="24sp" android:textColor="#FFFFFF"/>
</LinearLayout>
<LinearLayout android:id="@+id/rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="提出物をタップ → 提出済み  •  ＋で登録" android:textColor="#9BAFC7" android:textSize="11sp"/>
</LinearLayout>